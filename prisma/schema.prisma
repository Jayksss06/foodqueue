generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  TENANT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TenantStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
}

enum MenuStatus {
  AVAILABLE
  UNAVAILABLE
  OUT_OF_STOCK
}

enum SlotStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  REJECTED
  REFUNDED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  QRIS
  EWALLET
  VIRTUAL_ACCOUNT
}

enum NotificationType {
  ORDER
  PAYMENT
  REVIEW
  SYSTEM
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String          @map("password_hash")
  role           Role            @default(CUSTOMER)
  phone          String?
  status         UserStatus      @default(ACTIVE)
  sessionVersion Int             @default(0) @map("session_version")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  tenant         Tenant?
  cart           Cart?
  orders         Order[]
  notifications  Notification[]
  reviews        Review[]
  statusLogs     OrderStatusLog[]

  @@index([role, status])
  @@map("users")
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  address   String?
  timezone  String   @default("Asia/Jakarta")
  createdAt DateTime @default(now()) @map("created_at")
  tenants   Tenant[]

  @@map("venues")
}

model Tenant {
  id                     String       @id @default(cuid())
  ownerId                String       @unique @map("owner_id")
  venueId                String       @map("venue_id")
  name                   String
  slug                   String       @unique
  description            String?
  location               String?
  logoUrl                String?      @map("logo_url")
  defaultPreparationTime Int          @default(10) @map("default_preparation_time")
  slotDurationMinutes    Int          @default(15) @map("slot_duration_minutes")
  maxOrdersPerSlot       Int          @default(10) @map("max_orders_per_slot")
  isAcceptingOrders      Boolean      @default(true) @map("is_accepting_orders")
  status                 TenantStatus @default(PENDING_VERIFICATION)
  ratingAvg              Float        @default(0) @map("rating_avg")
  ratingCount            Int          @default(0) @map("rating_count")
  verifiedAt             DateTime?    @map("verified_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  owner          User                  @relation(fields: [ownerId], references: [id])
  venue          Venue                 @relation(fields: [venueId], references: [id])
  operatingHours TenantOperatingHour[]
  menus          Menu[]
  pickupSlots    PickupSlot[]
  orders         Order[]
  reviews        Review[]
  carts          Cart[]

  @@index([status])
  @@map("tenants")
}

model TenantOperatingHour {
  id        String  @id @default(cuid())
  tenantId  String  @map("tenant_id")
  dayOfWeek Int     @map("day_of_week") // 0 = Minggu ... 6 = Sabtu
  openTime  String  @map("open_time")   // "HH:mm"
  closeTime String  @map("close_time")  // "HH:mm"
  isClosed  Boolean @default(false) @map("is_closed")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek])
  @@map("tenant_operating_hours")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  menus       Menu[]

  @@map("categories")
}

model Menu {
  id              String     @id @default(cuid())
  tenantId        String     @map("tenant_id")
  categoryId      String     @map("category_id")
  name            String
  description     String?
  price           Int
  imageUrl        String?    @map("image_url")
  stock           Int        @default(0)
  preparationTime Int        @default(10) @map("preparation_time")
  status          MenuStatus @default(AVAILABLE)
  deletedAt       DateTime?  @map("deleted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([tenantId, status])
  @@index([categoryId])
  @@map("menus")
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant?    @relation(fields: [tenantId], references: [id])
  items  CartItem[]

  @@map("carts")
}

model CartItem {
  id            String  @id @default(cuid())
  cartId        String  @map("cart_id")
  menuId        String  @map("menu_id")
  quantity      Int
  priceSnapshot Int     @map("price_snapshot")
  notes         String?

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menu Menu @relation(fields: [menuId], references: [id])

  @@unique([cartId, menuId])
  @@map("cart_items")
}

model PickupSlot {
  id            String     @id @default(cuid())
  tenantId      String     @map("tenant_id")
  date          DateTime   @db.Date
  startAt       DateTime   @map("start_at")
  endAt         DateTime   @map("end_at")
  capacity      Int
  currentOrders Int        @default(0) @map("current_orders")
  status        SlotStatus @default(OPEN)

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  orders Order[]

  @@unique([tenantId, startAt])
  @@index([tenantId, date])
  @@map("pickup_slots")
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique @map("order_number")
  userId         String      @map("user_id")
  tenantId       String      @map("tenant_id")
  pickupSlotId   String      @map("pickup_slot_id")
  subtotal       Int
  fee            Int
  total          Int
  status         OrderStatus @default(PENDING_PAYMENT)
  notes          String?
  pickupCode     String      @unique @map("pickup_code")
  idempotencyKey String      @map("idempotency_key")
  expiresAt      DateTime?   @map("expires_at")
  paidAt         DateTime?   @map("paid_at")
  acceptedAt     DateTime?   @map("accepted_at")
  readyAt        DateTime?   @map("ready_at")
  completedAt    DateTime?   @map("completed_at")
  cancelledAt    DateTime?   @map("cancelled_at")
  cancelReason   String?     @map("cancel_reason")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user       User             @relation(fields: [userId], references: [id])
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  pickupSlot PickupSlot       @relation(fields: [pickupSlotId], references: [id])
  items      OrderItem[]
  payment    Payment?
  statusLogs OrderStatusLog[]
  review     Review?

  @@unique([userId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([userId, createdAt])
  @@index([pickupSlotId])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String  @map("order_id")
  menuId           String  @map("menu_id")
  menuNameSnapshot String  @map("menu_name_snapshot")
  priceSnapshot    Int     @map("price_snapshot")
  quantity         Int
  subtotal         Int
  notes            String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menu  Menu  @relation(fields: [menuId], references: [id])

  @@index([menuId])
  @@map("order_items")
}

model Payment {
  id                   String         @id @default(cuid())
  orderId              String         @unique @map("order_id")
  amount               Int
  method               PaymentMethod?
  provider             String         @default("MOCK")
  status               PaymentStatus  @default(PENDING)
  transactionReference String?        @unique @map("transaction_reference")
  paidAt               DateTime?      @map("paid_at")
  refundedAt           DateTime?      @map("refunded_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attempts PaymentAttempt[]

  @@index([status])
  @@map("payments")
}

model PaymentAttempt {
  id        String        @id @default(cuid())
  paymentId String        @map("payment_id")
  status    PaymentStatus
  method    PaymentMethod?
  message   String?
  rawResponse Json?       @map("raw_response")
  createdAt DateTime      @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_attempts")
}

model OrderStatusLog {
  id         String       @id @default(cuid())
  orderId    String       @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorId    String?      @map("actor_id")
  actorRole  Role?        @map("actor_role")
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_logs")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  title     String
  message   String
  type      NotificationType
  link      String?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique @map("order_id")
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  rating    Int
  comment   String?
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at")

  order  Order  @relation(fields: [orderId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("reviews")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model OrderCounter {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("order_counters")
}
