# FoodQueue Environment Variables
# Port & Host
PORT=3000

# Database Configuration (Neon / Supabase PostgreSQL)
# Format Neon Pooled (port 5432 / 6543 dengan pooler):
DATABASE_URL="postgresql://user:password@ep-cool-cloud-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Format Neon Direct (tanpa -pooler, untuk migrasi):
DIRECT_URL="postgresql://user:password@ep-cool-cloud-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT Secret (minimal 32 karakter)
JWT_SECRET="foodqueue-super-secret-key-2026-production-ready-min-32-chars"

# App Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
