# FoodQueue Environment Variables
# Port & Host
PORT=3000

# Database Configuration (Neon / Supabase PostgreSQL)
# Format Neon Pooled (port 5432 / 6543 dengan pooler):
DATABASE_URL="postgresql://user:password@ep-cool-cloud-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Format Neon Direct (tanpa -pooler, untuk migrasi):
DIRECT_URL="postgresql://user:password@ep-cool-cloud-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT Secret (minimal 32 karakter)
JWT_SECRET="foodqueue-super-secret-key-2026-production-ready-min-32-chars"

# App Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================================
# Payment Gateway Configuration (Xendit Payments API v3)
# ==========================================================
# Pilihan provider: XENDIT | MOCK
# Catatan: Di NODE_ENV="production", MOCK & simulasi otomatis dikunci/dinonaktifkan.
PAYMENT_PROVIDER="XENDIT"

# Xendit Secret API Key (dari Dashboard Xendit > Settings > Developers > API Keys)
# - Sandbox   : diawali xnd_development_...
# - Production: diawali xnd_production_...
XENDIT_SECRET_KEY=""

# Xendit Webhook Verification Token (dari Dashboard Xendit > Settings > Developers > Webhooks)
# Wajib diisi agar endpoint /api/payments/webhooks/xendit bisa memverifikasi header x-callback-token.
XENDIT_WEBHOOK_TOKEN=""

# Opsional: override endpoint / versi API Xendit
XENDIT_API_BASE_URL="https://api.xendit.co"
XENDIT_API_VERSION="2024-11-11"

# Opsional: aktifkan simulasi hanya untuk local dev dengan PAYMENT_PROVIDER="MOCK"
ENABLE_PAYMENT_SIMULATION="false"

# Cron Secret (wajib diisi di production untuk mengamankan /api/cron/expire-orders)
CRON_SECRET=""
